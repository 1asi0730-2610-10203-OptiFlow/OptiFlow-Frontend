@startuml BC-00_Shared

package "app" {
  class App <<component>> {
    + renders: Layout
  }
}

package "router" {
  class Router <<configuration>> {
    + history: WebHistory
    + routes: Route[]
    + beforeEach(guard): void
  }
}

package "shared.infrastructure" {
  class BaseApi {
    - http: AxiosInstance
    + constructor()
    + get http(): AxiosInstance
  }
  class BaseEndpoint {
    - http: AxiosInstance
    - resourcePath: string
    + constructor(http: AxiosInstance, resourcePath: string)
    + getAll(): Promise<any[]>
    + getById(id): Promise<any>
    + create(resource): Promise<any>
    + update(id, resource): Promise<any>
    + patch(id, resource): Promise<any>
    + delete(id): Promise<void>
    + getAllByParam(paramKey, paramValue): Promise<any[]>
  }
}

package "shared.presentation.components" {
  class Layout <<component>> {
    - navItems: NavItem[]
    + navigate(to: string): void
    + isActive(to: string): boolean
  }
}

package "shared.presentation.views" {
  class PageNotFound <<view>> {
    + navigateToSales(): void
  }
}

App *-- Layout : composes
Layout --> Router : uses (router-view + push)
PageNotFound --> Router : uses (push)

note right of BaseApi
  Extended by every bounded-context
  API class (SalesApi, PaymentApi, etc.)
  to obtain a configured AxiosInstance
  pointed at VITE_OPTIFLOW_API_URL.
end note

note right of BaseEndpoint
  Instantiated inside each API class
  using the AxiosInstance from BaseApi.
  Wraps CRUD + getAllByParam for a
  single REST resource path.
end note

note right of Layout
  App shell: sidebar with nav items
  and <router-view> main content area.
  Also mounts pv-toast and pv-confirm-dialog
  for global PrimeVue services.
end note

note bottom of Router
  Routes registered:
    /          → redirect /sales
    /sales     → SaleListView
    /lab-orders → LabOrderListView
    /inventory  → InventoryListView
    /:pathMatch → PageNotFound
end note

@enduml
